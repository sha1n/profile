#!/usr/bin/env zsh

# profile - Update the profile repo, or install or clean up the tools of machine profiles
#
# Usage: profile update
#        profile install [essentials] [dev]
#        profile cleanup
#   update      Pull the current branch of the repo, update its submodules, and remove
#               the submodules that the repo no longer lists
#   install     Install the Homebrew packages of the given profiles (default: essentials),
#               and the mise runtimes when dev is given
#   cleanup     List the Homebrew packages and mise runtimes that no profile lists,
#               and remove them after a confirmation
#   -h, --help  Show this help and exit
#
# Exit codes: 0 success, 1 a step failed, 2 usage error.

# Resolved here, because inside a function $0 is the function name.
__profile_repo="${0:A:h:h}"

source "$__profile_repo/scripts/lib.zsh" || exit 1

function __profile_cmd_usage() {
  print -r -- "usage: profile update
       profile install [essentials] [dev]
       profile cleanup

  update      pull the current branch of the repo, update its submodules, and remove
              the submodules that the repo no longer lists
  install     install the Homebrew packages of the given profiles (default: essentials),
              and the mise runtimes when dev is given
  cleanup     list the Homebrew packages and mise runtimes that no profile lists,
              and remove them after a confirmation
  -h, --help  show this help and exit"
}

function __profile_cmd_update() {
  emulate -L zsh
  local repo="$__profile_repo"

  if (( $# )); then
    __profile_cmd_usage >&2
    return 2
  fi

  __profile_log_section "Repository"
  git -C "$repo" pull origin "$(git -C "$repo" branch --show-current)" ||
    { __profile_log_error "git pull failed" >&2; return 1; }

  __profile_log_section "Submodules"
  git -C "$repo" submodule update --init --recursive ||
    { __profile_log_error "git submodule update failed" >&2; return 1; }

  __profile_log_section "Orphaned submodules"
  __profile_cmd_remove_orphans "$repo"
}

# Sets reply to the submodule names that <repo>/.gitmodules lists.
function __profile_cmd_listed_submodules() {
  emulate -L zsh
  local repo="$1" output="" key
  local -i code
  reply=()

  [[ -f "$repo/.gitmodules" ]] || return 0
  # git parses .gitmodules with its own quoting and comment rules, which a parser here could miss.
  output="$(git -C "$repo" config -f .gitmodules --name-only --get-regexp '^submodule\..+\.path$')"
  code=$?
  # Exit code 1 means no match.
  if (( code > 1 )); then
    __profile_log_error "could not read $repo/.gitmodules (exit code $code)" >&2
    return 1
  fi
  for key in "${(@f)output}"; do
    [[ -n "$key" ]] && reply+=("${${key#submodule.}%.path}")
  done
}

# Sets reply to the submodule names that have a section in the repo config.
function __profile_cmd_submodule_sections() {
  emulate -L zsh
  local repo="$1" output="" key
  local -i code
  reply=()

  # Two dots at least, so that settings like submodule.recurse are not taken for sections.
  output="$(git -C "$repo" config --local --name-only --get-regexp '^submodule\..+\.[^.]+$')"
  code=$?
  if (( code > 1 )); then
    __profile_log_error "could not read the submodule sections of $repo/.git/config (exit code $code)" >&2
    return 1
  fi
  for key in "${(@f)output}"; do
    [[ -n "$key" ]] && reply+=("${${key#submodule.}%.*}")
  done
  reply=("${(@u)reply}")
}

# Sets reply to the names of the submodule git dirs of <repo>, and REPLY to its absolute
# modules directory (empty when git reports no common dir).
function __profile_cmd_submodule_gitdirs() {
  emulate -L zsh
  setopt local_options null_glob
  local repo="$1" common="" dir
  local -a queue=()
  reply=()
  REPLY=""

  # The common dir, not <repo>/.git, so that a linked worktree finds the shared modules.
  common="$(git -C "$repo" rev-parse --git-common-dir)" ||
    { __profile_log_error "could not find the git directory of $repo" >&2; return 1; }
  if [[ -n "$common" ]]; then
    [[ "$common" == /* ]] || common="$repo/$common"
    REPLY="${common:A}/modules"
    queue=("$REPLY"/*(/))
    while (( ${#queue} )); do
      dir="${queue[1]}"
      shift queue
      # A git dir is not descended into, so nested submodules stay out of scope.
      if [[ -f "$dir/HEAD" ]]; then
        reply+=("${dir#$REPLY/}")
      else
        queue+=("$dir"/*(/))
      fi
    done
  fi
}

# Prints the absolute working tree path of the submodule git dir <gitdir> with name <name>.
function __profile_cmd_submodule_worktree() {
  emulate -L zsh
  local repo="$1" name="$2" gitdir="$3" worktree=""

  if [[ -d "$gitdir" ]]; then
    # git changes into core.worktree before any command and fails when it is gone, so
    # --work-tree points it at the git dir, which exists.
    worktree="$(git --git-dir="$gitdir" --work-tree="$gitdir" config --local core.worktree 2>/dev/null)"
  fi
  if [[ -z "$worktree" ]]; then
    worktree="$repo/$name"
  elif [[ "$worktree" != /* ]]; then
    worktree="$gitdir/$worktree"
  fi
  print -r -- "${worktree:A}"
}

# Succeeds when <worktree>/.git is a gitdir file that resolves to the existing <gitdir>.
function __profile_cmd_worktree_points_to() {
  emulate -L zsh
  local worktree="$1" gitdir="$2" line="" target=""

  [[ -d "$gitdir" && -f "$worktree/.git" ]] || return 1
  IFS= read -r line <"$worktree/.git" || [[ -n "$line" ]] || return 1
  [[ "$line" == "gitdir: "* ]] || return 1
  target="${line#gitdir: }"
  [[ "$target" == /* ]] || target="$worktree/$target"
  [[ "${target:A}" == "${gitdir:A}" ]]
}

# Sets REPLY to the reason to keep the orphan, or to an empty string when it may be removed.
function __profile_cmd_orphan_keep_reason() {
  emulate -L zsh
  local gitdir="$1" worktree="$2" output=""
  local -a refs=(--branches)
  REPLY=""

  [[ -d "$gitdir" ]] || return 0

  if [[ -n "$worktree" ]]; then
    output="$(git -C "$worktree" status --porcelain)" ||
      { REPLY="the safety check failed"; return 0; }
    [[ -n "$output" ]] && { REPLY="uncommitted changes or untracked files"; return 0; }
  fi

  # These checks read only refs, and --work-tree keeps git from changing into a deleted core.worktree.
  local -a git_refs=(git --git-dir="$gitdir" --work-tree="$gitdir")
  local -i code
  # rev-parse --verify --quiet exits with 1 for a missing ref, and with more on an error.
  "${git_refs[@]}" rev-parse --verify --quiet refs/stash >/dev/null
  code=$?
  (( code == 0 )) && { REPLY="a stash"; return 0; }
  (( code > 1 )) && { REPLY="the safety check failed"; return 0; }

  "${git_refs[@]}" rev-parse --verify --quiet HEAD >/dev/null
  code=$?
  (( code > 1 )) && { REPLY="the safety check failed"; return 0; }
  (( code == 0 )) && refs=(HEAD --branches)
  # No fetch: a stale remote-tracking ref can only make this check keep too much.
  output="$("${git_refs[@]}" rev-list --max-count=1 "${refs[@]}" --not --remotes)" ||
    { REPLY="the safety check failed"; return 0; }
  [[ -n "$output" ]] && REPLY="unpushed commits"
  return 0
}

# Removes the empty parent directories of <path>, up to but not including <stop>.
function __profile_cmd_remove_empty_parents() {
  emulate -L zsh
  local dir="${1:h}" stop="$2"

  while [[ "$dir" == "$stop"/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    dir="${dir:h}"
  done
}

# Removes the orphan <name>: its working tree when it points back, its git dir and its config section.
function __profile_cmd_remove_orphan() {
  emulate -L zsh
  local repo="$1" name="$2" modules="$3"
  local -i has_section="$4"
  local gitdir="" worktree="" live_worktree=""

  [[ -n "$modules" ]] && gitdir="$modules/$name"
  worktree="$(__profile_cmd_submodule_worktree "$repo" "$name" "$gitdir")"
  if [[ -n "$gitdir" && "${gitdir:A}" != "$modules"/* ]] ||
     [[ "$worktree" == "$repo" || "$worktree" != "$repo"/* ]]; then
    __profile_log_warn "kept orphaned submodule '$name': a path outside the repo" >&2
    return 0
  fi
  # Other content can occupy the path, for example files that the repo now tracks there.
  __profile_cmd_worktree_points_to "$worktree" "$gitdir" && live_worktree="$worktree"

  local REPLY=""
  __profile_cmd_orphan_keep_reason "$gitdir" "$live_worktree"
  if [[ -n "$REPLY" ]]; then
    __profile_log_warn "kept orphaned submodule '$name': $REPLY" >&2
    return 0
  fi

  # The config section goes last, so that after a failure the next update finds the orphan again.
  if [[ -n "$live_worktree" ]]; then
    rm -rf "$live_worktree" || return 1
    __profile_cmd_remove_empty_parents "$live_worktree" "$repo"
  fi
  if [[ -n "$gitdir" && -e "$gitdir" ]]; then
    rm -rf "$gitdir" || return 1
    __profile_cmd_remove_empty_parents "$gitdir" "$modules"
  fi
  if (( has_section )); then
    git -C "$repo" config --local --remove-section "submodule.$name" || return 1
  fi
  __profile_log_success "removed orphaned submodule '$name'"
}

# Removes the submodules of <repo> that .gitmodules no longer lists, unless they hold local work.
function __profile_cmd_remove_orphans() {
  emulate -L zsh
  local repo="$1" modules="" name REPLY=""
  local -a reply=() listed=() sections=() candidates=()
  local -i failed=0

  __profile_cmd_listed_submodules "$repo" || return 1
  listed=("${reply[@]}")
  __profile_cmd_submodule_sections "$repo" || return 1
  sections=("${reply[@]}")
  __profile_cmd_submodule_gitdirs "$repo" || return 1
  modules="$REPLY"
  candidates=("${sections[@]}" "${reply[@]}")
  candidates=("${(@u)candidates}")

  for name in "${candidates[@]}"; do
    (( ${listed[(Ie)$name]} )) && continue
    if ! __profile_cmd_remove_orphan "$repo" "$name" "$modules" "${sections[(Ie)$name]}"; then
      __profile_log_error "failed to remove orphaned submodule '$name'" >&2
      failed=1
    fi
  done
  return failed
}

# Sets reply to the known profiles of the Brewfile.
function __profile_cmd_known_profiles() {
  emulate -L zsh
  local brewfile="$__profile_repo/brew/Brewfile"
  local line
  reply=()

  # The Brewfile is the only list of profiles, so a second copy here could drift from it.
  local known_pattern='^known = %w\[([a-z. ]+)\]$'
  if [[ -r "$brewfile" ]]; then
    for line in "${(@f)$(<"$brewfile")}"; do
      if [[ "$line" =~ $known_pattern ]]; then
        reply=(${=match[1]})
        break
      fi
    done
  fi
  if (( ! ${#reply} )); then
    __profile_log_error "no 'known' profile list in $brewfile" >&2
    return 1
  fi
}

function __profile_cmd_install() {
  emulate -L zsh
  local repo="$__profile_repo"
  local -a known_profiles=() profiles=() reply=()
  local name

  __profile_cmd_known_profiles || return 1
  known_profiles=("${reply[@]}")

  for name in "$@"; do
    if [[ "$name" == -* ]]; then
      __profile_cmd_usage >&2
      return 2
    fi
    if (( ! ${known_profiles[(Ie)$name]} )); then
      __profile_log_error "unknown machine profile: '$name'" >&2
      return 2
    fi
    profiles+=("$name")
  done
  (( ${#profiles} )) || profiles=(essentials)

  __profile_log_section "Homebrew packages"
  if (( $+commands[brew] )); then
    HOMEBREW_PROFILE_INSTALL_PROFILES="${(j: :)profiles}" \
      brew bundle --no-upgrade --file "$repo/brew/Brewfile" </dev/null ||
      { __profile_log_error "brew bundle failed" >&2; return 1; }
  else
    __profile_log_warn "brew is not on PATH. Skipping brew bundle..." >&2
  fi

  (( ${profiles[(Ie)dev]} )) || return 0

  # brew bundle may have just installed mise, and the command hash table predates it.
  rehash
  __profile_log_section "mise runtimes"
  if (( $+commands[mise] )); then
    # Project config in the caller's directory (mise.toml, .tool-versions, and the idiomatic
    # files enabled by config/mise/profile.toml) would otherwise replace the machine-profile runtimes.
    (cd / && mise install </dev/null) || { __profile_log_error "mise install failed" >&2; return 1; }
  else
    __profile_log_warn "mise is not on PATH. Skipping mise install..." >&2
  fi
}

# Prints <question> and succeeds when the next input line is y or Y.
function __profile_cmd_confirm() {
  emulate -L zsh
  local answer=""
  print -n -- "$1 [y/N] "
  # At end of input no answer line was echoed, so the prompt line is still open.
  read -r answer || print
  [[ "$answer" == [yY] ]]
}

function __profile_cmd_cleanup_brew() {
  emulate -L zsh
  local profiles="$1" brewfile="$__profile_repo/brew/Brewfile"
  local output="" line
  local -a list=() names=()
  local -i code printing=0

  # Homebrew 6 asks before it removes; with stdin from /dev/null it cannot ask,
  # so this run only lists and exits with 1.
  output="$(cd / && HOMEBREW_PROFILE_INSTALL_PROFILES="$profiles" \
    brew bundle cleanup --file "$brewfile" </dev/null)"
  code=$?
  if (( code > 1 )); then
    __profile_log_error "the package list failed with exit code $code" >&2
    return 1
  fi
  for line in "${(@f)output}"; do
    [[ "$line" == "Would "* ]] && printing=1
    (( printing )) || continue
    [[ "$line" == *--force* || "$line" == *proceed* ]] && continue
    list+=("$line")
    [[ "$line" == "Would "* ]] || names+=(${=line})
  done

  # A list-only run that exits with 1 always prints a `Would ` line, so its absence means Homebrew failed.
  if (( code == 1 && ! printing )); then
    __profile_log_error "Homebrew failed with no package list (exit code $code)" >&2
    return 1
  fi
  if (( ! ${#names} )); then
    __profile_log_info "nothing to remove"
    return 0
  fi
  print -rl -- "${list[@]}"
  if ! __profile_cmd_confirm "Remove these ${#names} Homebrew packages?"; then
    __profile_log_info "nothing removed"
    return 0
  fi
  (cd / && HOMEBREW_PROFILE_INSTALL_PROFILES="$profiles" \
    brew bundle cleanup --force --file "$brewfile" </dev/null) ||
    { __profile_log_error "the package removal failed" >&2; return 1; }
}

function __profile_cmd_cleanup_mise() {
  emulate -L zsh
  local json="" list=""

  # mise writes the `prune --dry-run` list to stderr, and `--dry-run-code` exits with 1
  # both when versions are prunable and on a config error, so only this JSON is reliable.
  json="$(cd / && mise ls --prunable --json </dev/null)" ||
    { __profile_log_error "the runtime list failed with exit code $?" >&2; return 1; }
  if (( ! $+commands[jq] )); then
    __profile_log_error "jq is not on PATH, so the runtime list cannot be read" >&2
    return 1
  fi
  list="$(print -r -- "$json" |
    jq -r 'to_entries[] | .key as $tool | .value[] | "\($tool)@\(.version)"')" ||
    { __profile_log_error "the runtime list could not be read" >&2; return 1; }

  local -a versions=("${(@f)list}")
  versions=("${(@)versions:#}")
  if (( ! ${#versions} )); then
    __profile_log_info "no unused runtime versions"
    return 0
  fi
  print -rl -- "${versions[@]}"
  if ! __profile_cmd_confirm "Remove these ${#versions} runtime versions?"; then
    __profile_log_info "nothing removed"
    return 0
  fi
  (cd / && mise prune --tools --yes </dev/null) ||
    { __profile_log_error "the runtime removal failed" >&2; return 1; }
}

function __profile_cmd_cleanup() {
  emulate -L zsh
  local -a reply=()

  if (( $# )); then
    __profile_cmd_usage >&2
    return 2
  fi

  __profile_cmd_known_profiles || return 1

  __profile_log_section "Homebrew cleanup"
  if (( $+commands[brew] )); then
    # A subset would make the packages of the other profiles look unlisted.
    __profile_cmd_cleanup_brew "${(j: :)reply}" || return 1
  else
    __profile_log_warn "brew is not on PATH. Skipping brew bundle cleanup..." >&2
  fi

  __profile_log_section "mise prune"
  if (( $+commands[mise] )); then
    __profile_cmd_cleanup_mise || return 1
  else
    __profile_log_warn "mise is not on PATH. Skipping mise prune..." >&2
  fi
}

function __profile_cmd_main() {
  case "$1" in
    ""|help|-h|--help) __profile_cmd_usage; exit 0 ;;
    update) shift; __profile_cmd_update "$@"; exit $? ;;
    install) shift; __profile_cmd_install "$@"; exit $? ;;
    cleanup) shift; __profile_cmd_cleanup "$@"; exit $? ;;
    *) __profile_cmd_usage >&2; exit 2 ;;
  esac
}

# A profile update can rewrite this file while it runs, so the run starts only after zsh has parsed all of it.
__profile_cmd_main "$@"
