# Homebrew 6 refuses untrusted third-party taps (HOMEBREW_REQUIRE_TAP_TRUST default).
tap "sha1n/tap", trusted: true

# Prompt
brew "starship"
cask "font-jetbrains-mono-nerd-font"

# Core utilities
brew "coreutils"
brew "gnu-time"
brew "parallel"
brew "rsync"
brew "watch"
brew "wget"
brew "tree"
brew "bat"
brew "sha1n/tap/bert"

# Search and text processing
brew "fzf"
brew "jq"
brew "yq"
brew "ripgrep"
brew "poppler"

# Editors. essentials runs nvim stock; the nvim toolchain lives in dev.
brew "neovim"
cask "sublime-text"

# Git
brew "git"
brew "gh"
